{
  "manifest_version": 3,
  "name": "Confirmo - Portal (en vivo)",
  "version": "1.0.0",
  "description": "Side panel que muestra portal.tyresperu.com en vivo (sin build local) y le da permiso para buscar importe/nro. de operación en la pestaña activa.",
  "key": "",
  "permissions": ["sidePanel", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["https://portal.tyresperu.com/*", "http://localhost:*/*", "http://127.0.0.1:*/*"]
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Confirmo - Portal (en vivo)" },
  "side_panel": { "default_path": "panel.html" }
}
